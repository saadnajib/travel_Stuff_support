{
  "name": "@carrylink/ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CarryLink AI operations team: Claude-powered employees that triage KYC, disputes, trust & safety, growth and reporting, and file proposals for the founder to approve.",
  "scripts": {
    "ops": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts daemon",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx --import ./test/setup.ts --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
