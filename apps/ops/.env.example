# Anthropic API key from https://console.anthropic.com (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=
# Where the CarryLink API is running
CARRYLINK_API_URL=http://localhost:4000/api/v1
# The `ops` service account (seeded by `npm run seed -w apps/api`; change OPS_PASSWORD on both sides before going live)
OPS_EMAIL=ops@carrylink.dev
OPS_PASSWORD=Ops-Passw0rd!
# Model and effort. claude-opus-5 is the default; claude-sonnet-5 is cheaper; claude-fable-5-1 is the most capable.
OPS_MODEL=claude-opus-5
OPS_EFFORT=medium
# Daemon cadence: minutes between team runs, and the local hour for the daily digest
OPS_INTERVAL_MINUTES=30
OPS_DIGEST_HOUR=8
# true = the team reviews and prints what it would file, but files nothing
OPS_DRY_RUN=false
OPS_MAX_ITEMS_PER_RUN=20
