# apps/api
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-min-32-chars-change-me-min-32-chars
# 32-byte base64 key for AES-256-GCM field encryption (phone numbers, doc numbers)
FIELD_ENCRYPTION_KEY=
DATABASE_PATH=./data/carrylink.db
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# dev only: returns email-verification tokens in API responses so no SMTP is needed
DEV_RETURN_TOKENS=true
# apps/web (leave unset in local dev so the Vite proxy forwards /api to the API and cookies stay same-origin)
# VITE_API_URL=https://api.example.com/api/v1

# apps/api: AI-team auto-execution policy (see docs/OPERATIONS.md). Set OPS_AUTO_EXECUTE=false to make every proposal wait for you.
OPS_AUTO_EXECUTE=true
OPS_AUTO_DISPUTE_MAX_MINOR=5000
OPS_AUTO_MIN_CONFIDENCE=0.9
# Password for the seeded ops@carrylink.dev service account
OPS_PASSWORD=Ops-Passw0rd!
